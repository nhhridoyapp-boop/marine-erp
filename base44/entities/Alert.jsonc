{
  "name": "Alert",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "title": "\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u099f \u0995\u09cd\u09af\u09be\u099f\u09be\u0997\u09b0\u09bf"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "warning",
        "medium",
        "low",
        "info"
      ],
      "default": "warning"
    },
    "truckNumber": {
      "type": "string"
    },
    "normalizedTruckNumber": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "title": "\u09b6\u09bf\u09b0\u09cb\u09a8\u09be\u09ae"
    },
    "description": {
      "type": "string",
      "title": "\u09ac\u09bf\u09ac\u09b0\u09a3"
    },
    "ghat": {
      "type": "string"
    },
    "motherVesselName": {
      "type": "string",
      "title": "\u09ae\u09be\u09a6\u09be\u09b0 \u09ad\u09c7\u09b8\u09c7\u09b2 \u09a8\u09be\u09ae"
    },
    "lighterVesselName": {
      "type": "string",
      "title": "\u09b2\u09be\u0987\u099f\u09be\u09b0 \u09ad\u09c7\u09b8\u09c7\u09b2 \u09a8\u09be\u09ae"
    },
    "scaleName": {
      "type": "string",
      "title": "\u09b8\u09cd\u0995\u09c7\u09b2 \u09a8\u09be\u09ae"
    },
    "expectedValue": {
      "type": "string",
      "title": "\u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b6\u09bf\u09a4 \u09ae\u09be\u09a8"
    },
    "actualValue": {
      "type": "string",
      "title": "\u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09ae\u09be\u09a8"
    },
    "differenceKg": {
      "type": "number",
      "title": "\u09aa\u09be\u09b0\u09cd\u09a5\u0995\u09cd\u09af (KG)"
    },
    "actionRequired": {
      "type": "string",
      "title": "\u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa"
    },
    "enteredByName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "INVESTIGATING",
        "RESOLVED"
      ],
      "default": "OPEN"
    },
    "createdTime": {
      "type": "string"
    },
    "updatedTime": {
      "type": "string"
    },
    "relatedEmptyId": {
      "type": "string"
    },
    "relatedLoadingId": {
      "type": "string"
    },
    "previousRecord": {
      "type": "string",
      "title": "\u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 (JSON)"
    },
    "currentRecord": {
      "type": "string",
      "title": "\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 (JSON)"
    },
    "timeDifferenceMinutes": {
      "type": "number"
    },
    "investigationNotes": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "enum": [
        "SAN MARINE SURVEY & INSPECTION",
        "SEAQUANT MARINE SERVICES"
      ]
    },
    "motherVesselId": {
      "type": "string"
    },
    "lighterVesselId": {
      "type": "string"
    },
    "consigneeId": {
      "type": "string"
    },
    "relatedDailyDocumentId": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}