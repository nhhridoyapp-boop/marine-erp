{
  "name": "ERPUser",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u09aa\u09c2\u09b0\u09cd\u09a3 \u09a8\u09be\u09ae"
    },
    "employeeId": {
      "type": "string",
      "title": "Employee ID"
    },
    "email": {
      "type": "string",
      "title": "\u0987\u09ae\u09c7\u0987\u09b2"
    },
    "passwordHash": {
      "type": "string",
      "title": "Password Hash"
    },
    "role": {
      "type": "string",
      "enum": [
        "Master Super Admin",
        "Super Admin",
        "Operations Admin",
        "Supervisor",
        "Staff",
        "Admin"
      ],
      "default": "Staff"
    },
    "requestedRole": {
      "type": "string",
      "enum": [
        "Admin",
        "Supervisor",
        "Staff"
      ],
      "title": "\u0986\u09ac\u09c7\u09a6\u09a8\u0995\u09c3\u09a4 \u09aa\u09a6 (Join Request)"
    },
    "employeeType": {
      "type": "string",
      "enum": [
        "Staff",
        "Supervisor",
        "Admin",
        "Permanent Staff"
      ],
      "default": "Staff",
      "title": "\u0995\u09b0\u09cd\u09ae\u099a\u09be\u09b0\u09c0 \u09b6\u09cd\u09b0\u09c7\u09a3\u09bf"
    },
    "idStatus": {
      "type": "string",
      "enum": [
        "CLAIMED",
        "NEEDS_ID",
        "ASSIGNED",
        "VERIFIED",
        "PERMANENT_NO_ID"
      ],
      "title": "\u0986\u0987\u09a1\u09bf \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8"
    },
    "idReviewedByName": {
      "type": "string"
    },
    "idReviewedAt": {
      "type": "string"
    },
    "designation": {
      "type": "string",
      "title": "\u09aa\u09a6\u09ac\u09bf"
    },
    "department": {
      "type": "string",
      "title": "\u09ac\u09bf\u09ad\u09be\u0997"
    },
    "joiningDate": {
      "type": "string",
      "format": "date",
      "title": "\u09af\u09cb\u0997\u09a6\u09be\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996"
    },
    "mobile": {
      "type": "string",
      "title": "\u09ae\u09cb\u09ac\u09be\u0987\u09b2"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "deactivated",
        "ACTIVE",
        "SUSPENDED",
        "suspended"
      ],
      "default": "pending"
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "NOT VERIFIED",
        "VERIFICATION PENDING",
        "VERIFIED"
      ],
      "default": "NOT VERIFIED"
    },
    "rejectionReason": {
      "type": "string"
    },
    "joiningInfo": {
      "type": "string"
    },
    "requestDateTime": {
      "type": "string"
    },
    "invitedBy": {
      "type": "string"
    },
    "invitedByName": {
      "type": "string"
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedByName": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "rejectedBy": {
      "type": "string"
    },
    "rejectedByName": {
      "type": "string"
    },
    "rejectedAt": {
      "type": "string"
    },
    "trustedDevices": {
      "type": "string",
      "title": "Trusted Devices (JSON)"
    },
    "failedLoginCount": {
      "type": "number",
      "title": "\u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b2\u0997\u0987\u09a8 \u099a\u09c7\u09b7\u09cd\u099f\u09be",
      "default": 0
    },
    "lockedUntil": {
      "type": "string",
      "title": "\u09b2\u0995 \u09a5\u09be\u0995\u09ac\u09c7 (\u09b8\u09ae\u09af\u09bc)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}