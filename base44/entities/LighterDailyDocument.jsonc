      "type": "string",
      "title": "\u09a1\u09c1\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u099f (JSON)"
    },
    "reconciliationStatus": {
      "type": "string",
      "enum": [
        "MATCHED",
        "MISMATCH",
        "TRUCK_AND_BAG_MISMATCH",
        "TRUCK_MISMATCH",
        "BAG_MISMATCH",
        "PENDING"
      ],
      "default": "PENDING"
    },
    "remarks": {
      "type": "string"
    },
    "uploadedBy": {
      "type": "string"
    },
    "uploadedAt": {
      "type": "string"
    },
    "lastEditedBy": {
      "type": "string"
    },
    "lastEditedAt": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "enum": [
        "SAN MARINE SURVEY & INSPECTION",
        "SEAQUANT MARINE SERVICES"
      ]
    }
  },
  "required": [
    "date",
    "lighterVesselId"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}