      "type": "string"
    },
    "remarks": {
      "type": "string"
    },
    "employeeId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "lastEditedBy": {
      "type": "string"
    },
    "lastEditedAt": {
      "type": "string"
    }
