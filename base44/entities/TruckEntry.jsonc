      "title": "\u0986\u09ae\u09a6\u09be\u09a8\u09bf\u0995\u09be\u09b0\u0995"
    },
    "company": {
      "type": "string",
      "title": "\u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf",
