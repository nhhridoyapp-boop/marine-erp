      "type": "number",
      "title": "\u099f\u09cd\u09af\u09be\u09b2\u09bf/\u099f\u09c7\u09af\u09bc\u09be\u09b0 \u0993\u099c\u09a8 (KG)"
    },
    "weightIn": {
      "type": "number",
      "title": "Weight In (KG)"
    },
    "weightOut": {
      "type": "number",
      "title": "Weight Out (KG)"
    },
    "secondWeight": {
      "type": "number",
      "title": "\u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u0993\u09af\u09bc\u09c7\u099f (KG)"
    },
    "secondWeightDate": {
      "type": "string",
      "format": "date",
