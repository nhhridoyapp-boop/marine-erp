{
  "name": "TruckEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u09b2\u09cb\u09a1 \u09a4\u09be\u09b0\u09bf\u0996"
    },
